    "generate:maneuvers": "node scripts/generate-maneuvers.mjs",
    "generate:burning-wheel": "node scripts/generate-burning-wheel-catalog.mjs",
    "package:burning-wheel-source": "node scripts/package-burning-wheel-source.mjs",
